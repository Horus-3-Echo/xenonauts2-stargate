<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../GamePaths.props" Condition="Exists('../../GamePaths.props')" />
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>StargateX2</AssemblyName>
    <RootNamespace>StargateX2</RootNamespace>
    <Version>0.1.1</Version>
    <ExternalManagedPath Condition="'$(ExternalManagedPath)' == ''">$(GameManagedPath)</ExternalManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)/Assembly-CSharp.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManagedPath)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedPath)/UnityEngine.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ExternalManagedPath)/0Harmony.dll</HintPath><Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameManagedPath)' == ''" Text="Set GameManagedPath in GamePaths.props or with -p:GameManagedPath." />
    <ItemGroup>
      <RequiredGameLibrary Include="$(GameManagedPath)/Assembly-CSharp.dll;$(GameManagedPath)/Assembly-CSharp-firstpass.dll;$(GameManagedPath)/UnityEngine.dll;$(GameManagedPath)/UnityEngine.CoreModule.dll;$(ExternalManagedPath)/0Harmony.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredGameLibrary.Identity)')" Text="Required local library is missing: %(RequiredGameLibrary.Identity)" />
  </Target>
</Project>
